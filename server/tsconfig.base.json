{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@snake-and-ladders-monorepo/interfaces": [
        "../shared-library/src/lib/interfaces/index.ts"
      ],
      "@snake-and-ladders-monorepo/enums": [
        "../shared-library/src/lib/enums/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
